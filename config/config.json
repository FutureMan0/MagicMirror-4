{
  "language": "de",
  "theme": "cyberpunk",
  "timeFormat": 24,
  "gridSettings": {
    "columns": 3,
    "rows": 3,
    "gap": 12,
    "padding": 12,
    "columnSizes": [
      "minmax(320px, 1fr)",
      "1fr",
      "1fr"
    ],
    "rowSizes": [
      "auto",
      "1fr",
      "1fr"
    ]
  },
  "modules": [
    {
      "module": "clock",
      "position": {
        "column": 1,
        "row": 1,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": true,
      "config": {
        "timeFormat": "HH:mm:ss",
        "showDate": true,
        "dateFormat": "dddd, DD. MMMM YYYY"
      }
    },
    {
      "module": "weather",
      "position": {
        "column": 1,
        "row": 2,
        "columnSpan": 1,
        "rowSpan": 2,
        "align": "start",
        "justify": "start"
      },
      "enabled": true,
      "config": {
        "city": "St. Veit an der Glan,AT",
        "units": "metric",
        "forecastDays": 5,
        "showEffects": true
      }
    },
    {
      "module": "untis",
      "position": {
        "column": 2,
        "row": 1,
        "columnSpan": 2,
        "rowSpan": 3,
        "align": "start",
        "justify": "start"
      },
      "enabled": true,
      "config": {
        "viewMode": "week"
      }
    },
    {
      "module": "spotify",
      "position": "bottom_left",
      "enabled": false,
      "config": {
        "showCover": true,
        "showProgress": true,
        "showSpotifyCode": true
      }
    },
    {
      "module": "mmwave-presence",
      "position": {
        "column": 1,
        "row": 3,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": true,
      "config": {
        "port": "/dev/ttyAMA0",
        "baudRate": 256000,
        "sensitivity": 50,
        "offDelay": 120,
        "hideUI": true
      }
    },
    {
      "module": "github",
      "position": {
        "column": 3,
        "row": 3,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": false,
      "config": {
        "repos": "",
        "maxCommits": 3,
        "showPullRequests": true,
        "showStars": true
      }
    },
    {
      "module": "gitea",
      "position": {
        "column": 3,
        "row": 2,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": false,
      "config": {
        "instanceUrl": "",
        "repos": "",
        "maxCommits": 3,
        "showOpenIssues": true,
        "showStars": true,
        "allowInsecureTls": false
      }
    },
    {
      "module": "unraid",
      "position": {
        "column": 2,
        "row": 3,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": false,
      "config": {
        "serverUrl": "",
        "allowInsecureTls": true,
        "showSystem": true,
        "showArray": true,
        "showDocker": true,
        "showVms": false,
        "maxDisks": 8,
        "warnTemp": 45
      }
    },
    {
      "module": "home-assistant",
      "position": {
        "column": 2,
        "row": 2,
        "columnSpan": 1,
        "rowSpan": 1,
        "align": "start",
        "justify": "start"
      },
      "enabled": false,
      "config": {
        "baseUrl": "http://homeassistant.local:8123",
        "entities": "",
        "allowControl": false,
        "showUnavailable": false
      }
    }
  ],
  "privacy": {
    "mode": "normal",
    "default": "normal",
    "guest": {
      "autoRevertMinutes": 30
    },
    "shower": {
      "trigger": "auto",
      "zone": {
        "minDistanceCm": 0,
        "maxDistanceCm": 120
      },
      "dwellSeconds": 20,
      "exitDelaySeconds": 60,
      "display": "clock",
      "dimOpacity": 0.35,
      "sensorHardOff": true
    }
  },
  "input": {
    "enabled": false,
    "provider": "mock",
    "cooldownMs": 400,
    "minConfidence": 0.6,
    "bindings": {
      "swipe_left": "page.next",
      "swipe_right": "page.prev",
      "swipe_up": "spotify.next",
      "swipe_down": "spotify.previous",
      "palm_hold": "privacy.toggleGuest",
      "hand_present": "display.wake"
    }
  }
}
