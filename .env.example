# API Keys
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Wird nach dem OAuth-Flow automatisch gesetzt
SPOTIFY_REFRESH_TOKEN=

# WebUntis Configuration
UNTIS_SERVER=htl-klu.webuntis.com
UNTIS_USERNAME=your_username
UNTIS_PASSWORD=your_password
UNTIS_SCHOOL=htl-klu

# Anmeldung der Web-Oberflaeche
# MM_ADMIN_TOKEN wird beim ersten Start automatisch erzeugt und hier
# eingetragen. Es ist der Weg hinein, falls die Kopplung per QR nicht geht.
MM_ADMIN_TOKEN=
# Notausgang: MM_AUTH=off deaktiviert die Anmeldung vollstaendig. Dann kann
# JEDER im Netzwerk die Konfiguration aendern und Updates ausloesen.
# MM_AUTH=off

# Display Settings
DEFAULT_INSTANCE=display1
CONFIG_PORT=3000

# Presence Sensor (UART)
PRESENCE_SENSOR_PORT=/dev/ttyUSB0
PRESENCE_TIMEOUT=60000
PRESENCE_DIM_TIMEOUT=300000
