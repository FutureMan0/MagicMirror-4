{
  "name": "magic-mirror-4",
  "version": "1.0.0",
  "description": "Modular Magic Mirror System with Web interface, Multi-display support and Auto-update.",
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FutureMan0/MagicMirror-4.git"
  },
  "homepage": "https://github.com/FutureMan0/MagicMirror-4#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "display1": "electron . --instance=display1 --screen=0",
    "display2": "electron . --instance=display2 --screen=1 --no-server",
    "display1:dev": "electron . --instance=display1 --screen=0 --dev",
    "display2:dev": "electron . --instance=display2 --screen=1 --no-server --dev",
    "build": "electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "verify": "npm run lint && npm run check:tokens && npm test",
    "routes": "node scripts/collect-routes.js",
    "fonts:build": "node scripts/build-fonts.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "magic-mirror",
    "electron",
    "webuntis",
    "smart-mirror"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.5"
  },
  "build": {
    "appId": "com.magicmirror.4",
    "productName": "MagicMirror 4",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "modules/**/*",
      "config/**/*",
      "package.json"
    ]
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
