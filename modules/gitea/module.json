{
  "apiVersion": 2,
  "name": "gitea",
  "displayName": "Gitea",
  "version": "1.0.0",
  "description": {
    "en": "Latest commits and open issues of a Gitea or Forgejo instance.",
    "de": "Letzte Commits und offene Vorgänge einer Gitea- oder Forgejo-Instanz."
  },
  "author": "MagicMirror⁴",
  "secrets": [
    {
      "key": "token",
      "env": "GITEA_TOKEN",
      "label": "Gitea Token",
      "exposeToRenderer": false
    }
  ],
  "provides": [
    "data:gitea"
  ],
  "config": {
    "instanceUrl": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Address of the instance, e.g. https://git.home.lan",
        "de": "Adresse der Instanz, z. B. https://git.zuhause.lan"
      }
    },
    "repos": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Repositories, comma-separated (e.g. luis/mirror, team/website)",
        "de": "Repositories, kommagetrennt (z. B. luis/spiegel, team/website)"
      }
    },
    "token": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Access token. Needed for private repositories.",
        "de": "Zugriffstoken. Für private Repositories nötig."
      }
    },
    "maxCommits": {
      "type": "number",
      "default": 3,
      "min": 1,
      "max": 10,
      "description": {
        "en": "Number of commits shown per repository",
        "de": "Anzahl der angezeigten Commits je Repository"
      }
    },
    "showOpenIssues": {
      "type": "boolean",
      "default": true,
      "description": {
        "en": "Show the number of open issues",
        "de": "Anzahl offener Vorgänge anzeigen"
      }
    },
    "showStars": {
      "type": "boolean",
      "default": true,
      "description": {
        "en": "Show stars",
        "de": "Sterne anzeigen"
      }
    },
    "allowInsecureTls": {
      "type": "boolean",
      "default": false,
      "description": {
        "en": "Accept a self-signed certificate (only sensible on your own network)",
        "de": "Selbstsigniertes Zertifikat akzeptieren (nur im eigenen Netz sinnvoll)"
      }
    },
    "updateInterval": {
      "type": "number",
      "default": 300000,
      "min": 60000,
      "description": {
        "en": "Update interval in milliseconds",
        "de": "Aktualisierungsintervall in Millisekunden"
      }
    }
  },
  "privacyLevel": "personal"
}
