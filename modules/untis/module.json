{
  "name": "untis",
  "displayName": {
    "de": "WebUntis Stundenplan",
    "en": "WebUntis timetable"
  },
  "version": "1.0.0",
  "description": {
    "en": "Shows the timetable from WebUntis",
    "de": "Zeigt Stundenplan von WebUntis"
  },
  "author": "Magic Mirror",
  "config": {
    "server": {
      "type": "string",
      "default": "",
      "description": {
        "en": "WebUntis server (e.g. htl-klu.webuntis.com)",
        "de": "WebUntis Server (z.B. htl-klu.webuntis.com)"
      }
    },
    "username": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Username",
        "de": "Benutzername"
      }
    },
    "password": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Password",
        "de": "Passwort"
      }
    },
    "school": {
      "type": "string",
      "default": "",
      "description": {
        "en": "School name",
        "de": "Schulname"
      }
    },
    "classId": {
      "type": "number",
      "default": 0,
      "description": {
        "en": "Class ID",
        "de": "Klassen-ID"
      }
    },
    "className": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Class name (e.g. 5BHEL)",
        "de": "Klassenname (z.B. 5BHEL)"
      }
    },
    "viewMode": {
      "type": "string",
      "default": "week",
      "description": {
        "en": "View mode (week/day/next)",
        "de": "Ansichtsmodus (week/day/next)"
      }
    },
    "colorNormal": {
      "type": "string",
      "default": "#00D4FF",
      "description": {
        "en": "Color for regular lessons",
        "de": "Farbe für normale Stunden"
      }
    },
    "colorSpecial": {
      "type": "string",
      "default": "#FFA500",
      "description": {
        "en": "Color for specific subjects",
        "de": "Farbe für bestimmte Fächer"
      }
    },
    "colorCancelled": {
      "type": "string",
      "default": "#FF4444",
      "description": {
        "en": "Color for cancelled lessons",
        "de": "Farbe für Entfälle"
      }
    }
  },
  "apiVersion": 2,
  "secrets": [
    {
      "key": "server",
      "env": "UNTIS_SERVER",
      "label": {
        "en": "WebUntis server",
        "de": "WebUntis Server"
      },
      "exposeToRenderer": false
    },
    {
      "key": "username",
      "env": "UNTIS_USERNAME",
      "label": {
        "en": "Username",
        "de": "Benutzername"
      },
      "exposeToRenderer": false
    },
    {
      "key": "password",
      "env": "UNTIS_PASSWORD",
      "label": {
        "en": "Password",
        "de": "Passwort"
      },
      "exposeToRenderer": false
    },
    {
      "key": "school",
      "env": "UNTIS_SCHOOL",
      "label": {
        "en": "School ID",
        "de": "Schulkennung"
      },
      "exposeToRenderer": false
    }
  ],
  "privacyLevel": "sensitive"
}
