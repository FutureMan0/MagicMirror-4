{
  "apiVersion": 2,
  "name": "home-assistant",
  "displayName": "Home Assistant",
  "version": "1.0.0",
  "description": {
    "en": "Show the state of selected entities — and switch them from your phone.",
    "de": "Zustände ausgewählter Entitäten anzeigen — und am Handy schalten."
  },
  "author": "MagicMirror⁴",
  "secrets": [
    {
      "key": "token",
      "env": "HOME_ASSISTANT_TOKEN",
      "label": {
        "en": "Long-lived access token",
        "de": "Langlebiger Zugriffstoken"
      },
      "exposeToRenderer": false
    }
  ],
  "provides": [
    "data:home-assistant"
  ],
  "config": {
    "baseUrl": {
      "type": "string",
      "default": "http://homeassistant.local:8123",
      "description": {
        "en": "Home Assistant address",
        "de": "Adresse von Home Assistant"
      }
    },
    "token": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Create it at the very bottom of your HA profile under “Long-lived access tokens”. Valid for ten years.",
        "de": "Im HA-Profil ganz unten unter „Langlebige Zugriffstokens\" erzeugen. Zehn Jahre gültig."
      }
    },
    "entities": {
      "type": "string",
      "default": "",
      "description": {
        "en": "Entities, comma-separated (e.g. light.living_room, sensor.outside_temperature)",
        "de": "Entitäten, kommagetrennt (z. B. light.wohnzimmer, sensor.aussentemperatur)"
      }
    },
    "allowControl": {
      "type": "boolean",
      "default": false,
      "description": {
        "en": "Allow switching. Only affects the listed entities and only switchable kinds (light, switch, scene, media, cover, fan, climate).",
        "de": "Schalten erlauben. Betrifft nur die aufgelisteten Entitäten und nur schaltbare Gattungen (Licht, Schalter, Szene, Medien, Rollladen, Lüfter, Klima)."
      }
    },
    "showUnavailable": {
      "type": "boolean",
      "default": false,
      "description": {
        "en": "Show unreachable entities anyway",
        "de": "Nicht erreichbare Entitäten trotzdem anzeigen"
      }
    },
    "allowInsecureTls": {
      "type": "boolean",
      "default": false,
      "description": {
        "en": "Accept a self-signed certificate",
        "de": "Selbstsigniertes Zertifikat akzeptieren"
      }
    },
    "updateInterval": {
      "type": "number",
      "default": 15000,
      "min": 5000,
      "description": {
        "en": "Update interval in milliseconds",
        "de": "Aktualisierungsintervall in Millisekunden"
      }
    }
  },
  "privacyLevel": "personal"
}
