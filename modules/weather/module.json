{
  "name": "weather",
  "displayName": {
    "de": "Wetter",
    "en": "Weather"
  },
  "version": "1.0.0",
  "description": {
    "en": "Weather display using OpenWeatherMap",
    "de": "Wetter-Anzeige mit OpenWeatherMap"
  },
  "author": "Magic Mirror",
  "config": {
    "apiKey": {
      "type": "string",
      "default": "",
      "description": "OpenWeatherMap API Key"
    },
    "city": {
      "type": "string",
      "default": "Vienna,AT",
      "description": {
        "en": "City (Name,CountryCode or lat,lon)",
        "de": "Stadt (Name,CountryCode oder lat,lon)"
      }
    },
    "units": {
      "type": "string",
      "default": "metric",
      "description": {
        "en": "Units (metric/imperial)",
        "de": "Einheiten (metric/imperial)"
      }
    },
    "forecastDays": {
      "type": "number",
      "default": 5,
      "description": {
        "en": "Number of forecast days",
        "de": "Anzahl Vorhersage-Tage"
      }
    },
    "showEffects": {
      "type": "boolean",
      "default": true,
      "description": {
        "en": "Show weather effects",
        "de": "Wetter-Effekte anzeigen"
      }
    },
    "showAlerts": {
      "type": "boolean",
      "default": true,
      "description": {
        "en": "Show weather warnings",
        "de": "Wetter-Warnungen anzeigen"
      }
    },
    "alertRefreshInterval": {
      "type": "number",
      "default": 300000,
      "description": {
        "en": "Update interval for warnings (ms)",
        "de": "Aktualisierungsintervall für Warnungen (ms)"
      }
    }
  },
  "apiVersion": 2,
  "secrets": [
    {
      "key": "apiKey",
      "env": "OPENWEATHERMAP_API_KEY",
      "label": "OpenWeatherMap API Key",
      "exposeToRenderer": false
    }
  ],
  "privacyLevel": "public"
}
