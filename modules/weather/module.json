{
  "name": "weather",
  "displayName": {
    "de": "Wetter",
    "en": "Weather"
  },
  "version": "1.0.0",
  "description": "Wetter-Anzeige mit OpenWeatherMap",
  "author": "Magic Mirror",
  "config": {
    "apiKey": {
      "type": "string",
      "default": "",
      "description": "OpenWeatherMap API Key"
    },
    "city": {
      "type": "string",
      "default": "Vienna,AT",
      "description": "Stadt (Name,CountryCode oder lat,lon)"
    },
    "units": {
      "type": "string",
      "default": "metric",
      "description": "Einheiten (metric/imperial)"
    },
    "forecastDays": {
      "type": "number",
      "default": 5,
      "description": "Anzahl Vorhersage-Tage"
    },
    "showEffects": {
      "type": "boolean",
      "default": true,
      "description": "Wetter-Effekte anzeigen"
    },
    "showAlerts": {
      "type": "boolean",
      "default": true,
      "description": "Wetter-Warnungen anzeigen"
    },
    "alertRefreshInterval": {
      "type": "number",
      "default": 300000,
      "description": "Aktualisierungsintervall für Warnungen (ms)"
    }
  },
  "apiVersion": 2,
  "secrets": [
    {
      "key": "apiKey",
      "env": "OPENWEATHERMAP_API_KEY",
      "label": "OpenWeatherMap API Key",
      "exposeToRenderer": true
    }
  ],
  "privacyLevel": "public"
}
