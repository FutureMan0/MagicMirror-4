{
  "name": "spotify",
  "displayName": "Spotify",
  "version": "1.0.0",
  "description": "Zeigt aktuell abgespielten Spotify Song",
  "author": "Magic Mirror",
  "config": {
    "clientId": {
      "type": "string",
      "default": "",
      "description": "Client ID aus dem Spotify-Dashboard. Ein Client Secret wird nicht mehr gebraucht."
    },
    "refreshToken": {
      "type": "string",
      "default": "",
      "description": "Wird beim Verbinden automatisch gesetzt."
    },
    "showCover": {
      "type": "boolean",
      "default": true,
      "description": "Album Cover anzeigen"
    },
    "showProgress": {
      "type": "boolean",
      "default": true,
      "description": "Fortschrittsbalken anzeigen"
    },
    "showSpotifyCode": {
      "type": "boolean",
      "default": true,
      "description": "Spotify Code anzeigen"
    },
    "updateInterval": {
      "type": "number",
      "default": 5000,
      "description": "Update-Intervall in Millisekunden"
    },
    "showControls": {
      "type": "boolean",
      "default": true,
      "description": "Wiedergabe am Handy steuern (Play, Pause, Weiter)"
    },
    "redirectUri": {
      "type": "string",
      "default": "",
      "description": "Nur bei eigenem Fork nötig — sonst leer lassen."
    }
  },
  "apiVersion": 2,
  "secrets": [
    {
      "key": "clientId",
      "env": "SPOTIFY_CLIENT_ID",
      "label": "Client ID",
      "exposeToRenderer": false
    },
    {
      "key": "refreshToken",
      "env": "SPOTIFY_REFRESH_TOKEN",
      "label": "Refresh Token",
      "exposeToRenderer": false
    }
  ],
  "provides": [
    "spotify:connected"
  ],
  "privacyLevel": "personal"
}
